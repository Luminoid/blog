// Hide "Keep on posting" in Archive Page
.archive .collection-title {
  display: none !important;
}

// Inline code style 
code {
  background: #eeeeee;
  color: #555555;
}

code[class*="language-"], pre[class*="language-"] {
  font-family: 'FiraCode Nerd Font', Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace;
}

// Sidebar blogroll links — tighter spacing
.links-of-blogroll-list {
  gap: 0;
}
.sidebar-inner .links-of-blogroll-item a {
  line-height: 1.4;
  font-size: 1em;
  padding: 0 5px;
}

// Table cells: explicit left alignment plus restoring markdown column alignment.
// Markdown alignment syntax (`|:---:|`, `|---:|`) emits an HTML `align` attribute,
// which has lower specificity than author CSS, so the explicit overrides re-instate it.
.post-body table td,
.post-body table th {
  text-align: left;
}

.post-body table td[align="center"],
.post-body table th[align="center"] {
  text-align: center;
}

.post-body table td[align="right"],
.post-body table th[align="right"] {
  text-align: right;
}
